# Frontend calls backend directly. Set this to backend origin (default: localhost:8080).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# Backend CORS allowlist. Add frontend origin when frontend/backend run on different origins.
# CORS_ALLOWED_ORIGINS="http://localhost:3001"

# Backend settings (used by go-boilerplate, not Next.js)
MONGODB_URL="mongodb://127.0.0.1:27017/jokihub"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
APP_BASE_URL="http://localhost:3001"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
PAYMENT_QRIS_IMAGE_URL=""
PAYMENT_BCA_BANK_NAME="BCA"
PAYMENT_BCA_ACCOUNT_NUMBER=""
PAYMENT_BCA_ACCOUNT_HOLDER=""

# Private object storage, if payment proof uploads are enabled
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="ap-southeast-1"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# Feature flags
FEATURE_SPRINT_2="false"
FEATURE_GOOGLE_AUTH="false"
FEATURE_REGISTER="false"
FEATURE_PASSWORD_RECOVERY="false"
