                  },
                  "created_at": {
                    "bsonType": "date"
                  },
                  "default_currency": {
                    "bsonType": "string"
                  },
                  "instagram_url": {
                    "bsonType": [
                      "null",
                      "string"
                    ]
                  },
                  "maintenance_mode": {
                    "bsonType": "bool"
                  },
                  "singleton_key": {
                    "bsonType": "string"
                  },
                  "site_description": {
                    "bsonType": [
                      "null",
                      "string"
                    ]
                  },
                  "site_name": {
                    "bsonType": "string"
                  },
                  "social_links": {
                    "bsonType": [
                      "object",
                      "array",
                      "string",
                      "double",
                      "int",
                      "long",
                      "bool",
                      "null"
                    ]
                  },
                  "timezone": {
                    "bsonType": "string"
                  },
                  "updated_at": {
                    "bsonType": "date"
                  },
                  "updated_by": {
                    "bsonType": [
                      "null",
                      "objectId"
                    ]
                  },
                  "version": {
                    "bsonType": "int"
                  }
                },
                "required": [
                  "_id",
                  "allow_registration",
                  "contact_email",
                  "contact_whatsapp",
                  "created_at",
                  "default_currency",
                  "maintenance_mode",
                  "singleton_key",
                  "site_name",
                  "timezone",
                  "updated_at",
                  "version"
                ]
              }
            }
          ]
        },
        "expect": "exists"
      }
    ]
  }
