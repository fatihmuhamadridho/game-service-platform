[
  {
    "id": "validator.platform_settings.update",
    "label": "Update validator on platform_settings (added: business_hours, social_links)",
    "operationClass": "widening",
    "precheck": [
      {
        "description": "collection platform_settings exists",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "platform_settings"
        },
        "expect": "exists"
      }
    ],
    "execute": [
      {
        "description": "modify platform_settings",
        "command": {
          "kind": "collMod",
          "collection": "platform_settings",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "allow_registration": {
                  "bsonType": "bool"
                },
                "business_hours": {
                  "bsonType": [
                    "null",
                    "string"
                  ]
                },
                "contact_email": {
                  "bsonType": "string"
                },
                "contact_whatsapp": {
                  "bsonType": "string"
                },
                "created_at": {
                  "bsonType": "date"
                },
                "default_currency": {
                  "bsonType": "string"
                },
                "instagram_url": {
                  "bsonType": [
                    "null",
                    "string"
                  ]
                },
                "maintenance_mode": {
                  "bsonType": "bool"
                },
                "singleton_key": {
                  "bsonType": "string"
                },
                "site_description": {
                  "bsonType": [
                    "null",
                    "string"
                  ]
                },
                "site_name": {
                  "bsonType": "string"
                },
                "social_links": {
                  "bsonType": [
                    "object",
                    "array",
                    "string",
                    "double",
                    "int",
                    "long",
                    "bool",
                    "null"
                  ]
                },
                "timezone": {
                  "bsonType": "string"
                },
                "updated_at": {
                  "bsonType": "date"
                },
                "updated_by": {
                  "bsonType": [
                    "null",
                    "objectId"
                  ]
                },
                "version": {
                  "bsonType": "int"
                }
              },
              "required": [
                "_id",
                "allow_registration",
                "contact_email",
                "contact_whatsapp",
                "created_at",
                "default_currency",
                "maintenance_mode",
                "singleton_key",
                "site_name",
                "timezone",
                "updated_at",
                "version"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": [
      {
        "description": "validator applied on platform_settings",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "platform_settings"
            },
            {
              "kind": "field",
              "field": "options.validationLevel",
              "op": "$eq",
              "value": "strict"
            },
            {
              "kind": "field",
              "field": "options.validationAction",
              "op": "$eq",
              "value": "error"
            },
            {
              "kind": "field",
              "field": "options.validator.$jsonSchema",
              "op": "$eq",
              "value": {
                "additionalProperties": false,
                "bsonType": "object",
                "properties": {
                  "_id": {
                    "bsonType": "objectId"
                  },
                  "allow_registration": {
                    "bsonType": "bool"
                  },
                  "business_hours": {
                    "bsonType": [
                      "null",
                      "string"
                    ]
                  },
                  "contact_email": {
