[
  {
    "id": "collection.auth_rate_limit_bucket.create",
    "label": "Create collection auth_rate_limit_bucket",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "collection auth_rate_limit_bucket does not exist",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "auth_rate_limit_bucket"
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create collection auth_rate_limit_bucket",
        "command": {
          "kind": "createCollection",
          "collection": "auth_rate_limit_bucket",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "bucket_key": {
                  "bsonType": "string"
                },
                "created_at": {
                  "bsonType": "date"
                },
                "expires_at": {
                  "bsonType": "date"
                },
                "request_count": {
                  "bsonType": "int"
                }
              },
              "required": ["_id", "bucket_key", "created_at", "expires_at", "request_count"]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": []
  },
  {
    "id": "index.auth_rate_limit_bucket.create(bucket_key:1)",
    "label": "Create index on auth_rate_limit_bucket (bucket_key:1)",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "index does not already exist on auth_rate_limit_bucket",
        "source": {
          "kind": "listIndexes",
          "collection": "auth_rate_limit_bucket"
        },
        "filter": {
          "kind": "field",
          "field": "key",
          "op": "$eq",
          "value": {
            "bucket_key": 1
          }
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create index on auth_rate_limit_bucket",
        "command": {
          "kind": "createIndex",
          "collection": "auth_rate_limit_bucket",
          "keys": [
            {
              "direction": 1,
              "field": "bucket_key"
            }
          ],
          "unique": true,
          "name": "bucket_key_1"
        }
      }
    ],
    "postcheck": [
      {
        "description": "index exists on auth_rate_limit_bucket",
        "source": {
          "kind": "listIndexes",
          "collection": "auth_rate_limit_bucket"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "key",
              "op": "$eq",
              "value": {
                "bucket_key": 1
              }
            },
            {
              "kind": "field",
              "field": "unique",
              "op": "$eq",
              "value": true
            }
          ]
        },
        "expect": "exists"
      }
    ]
  }
]
