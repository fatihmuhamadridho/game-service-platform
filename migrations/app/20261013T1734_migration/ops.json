[
  {
    "id": "index.admin_account.create(username:1)",
    "label": "Create index on admin_account (username:1)",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "index does not already exist on admin_account",
        "source": {
          "kind": "listIndexes",
          "collection": "admin_account"
        },
        "filter": {
          "kind": "field",
          "field": "key",
          "op": "$eq",
          "value": {
            "username": 1
          }
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create index on admin_account",
        "command": {
          "kind": "createIndex",
          "collection": "admin_account",
          "keys": [
            {
              "direction": 1,
              "field": "username"
            }
          ],
          "unique": true,
          "name": "username_1"
        }
      }
    ],
    "postcheck": [
      {
        "description": "index exists on admin_account",
        "source": {
          "kind": "listIndexes",
          "collection": "admin_account"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "key",
              "op": "$eq",
              "value": {
                "username": 1
              }
            },
            {
              "kind": "field",
              "field": "unique",
              "op": "$eq",
              "value": true
            }
          ]
        },
        "expect": "exists"
      }
    ]
  },
  {
    "id": "validator.admin_account.update",
    "label": "Update validator on admin_account (added: password_hash, username)",
    "operationClass": "widening",
    "precheck": [
      {
        "description": "collection admin_account exists",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "admin_account"
        },
        "expect": "exists"
      }
    ],
    "execute": [
      {
        "description": "modify admin_account",
        "command": {
          "kind": "collMod",
          "collection": "admin_account",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "created_at": {
                  "bsonType": "date"
                },
                "deleted_at": {
                  "bsonType": ["null", "date"]
                },
                "email": {
                  "bsonType": "string"
                },
                "name": {
                  "bsonType": "string"
                },
                "password_hash": {
                  "bsonType": "string"
                },
                "status": {
                  "bsonType": "string"
                },
                "updated_at": {
                  "bsonType": "date"
                },
                "username": {
                  "bsonType": "string"
                }
              },
              "required": ["_id", "created_at", "email", "name", "password_hash", "status", "updated_at", "username"]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": [
      {
        "description": "validator applied on admin_account",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "admin_account"
            },
            {
              "kind": "field",
              "field": "options.validationLevel",
